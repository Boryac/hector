# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Auth0 Configuration (optional)
AUTH0_DOMAIN=your_auth0_domain.auth0.com
AUTH0_AUDIENCE=your_api_audience

# Server Configuration (optional, defaults in config)
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Hector ResearchOS（产品链路，cmd/researchos）
# 复制为 .env.researchos 后填写；.env.researchos 已被 .gitignore 忽略，不要提交。
# ---------------------------------------------------------------------------
# 必填：数据库与本地 API Token
RESEARCHOS_DATABASE_URL=postgres://postgres@127.0.0.1:5432/researchos?sslmode=disable
RESEARCHOS_API_TOKEN=replace-with-a-long-random-string
# 单用户本地模式的身份（服务端唯一身份，客户端无法指定）
RESEARCHOS_LOCAL_USER=local-user
RESEARCHOS_ADDR=127.0.0.1:8080

# 可选：LLM（留空则规划与抽取降级为本地确定性流程，报告中会如实标注）
RESEARCHOS_LLM_PROVIDER=none
RESEARCHOS_LLM_API_KEY=
RESEARCHOS_LLM_MODEL=
RESEARCHOS_LLM_BASE_URL=

# 可选：检索 Provider（免密钥：github / hackernews / wikipedia / bing）
RESEARCHOS_SEARCH_PROVIDERS=github,hackernews,wikipedia
RESEARCHOS_GITHUB_TOKEN=
RESEARCHOS_TAVILY_API_KEY=
RESEARCHOS_SERPAPI_KEY=
RESEARCHOS_BRAVE_API_KEY=

# 可选：并发与超时
RESEARCHOS_WORKERS=4
RESEARCHOS_MAX_AGENTS=4
RESEARCHOS_NODE_TIMEOUT=180s
RESEARCHOS_REQUIRE_APPROVAL=false

# 可选：数据与静态前端
RESEARCHOS_DATA_DIR=./data
RESEARCHOS_WEB_DIR=./web/.build
