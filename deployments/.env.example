# deployments/.env.example — 生产编排的环境变量模板
#
#   cp deployments/.env.example deployments/.env
#   然后至少改掉 RESEARCHOS_API_TOKEN 与 POSTGRES_PASSWORD 两项。
#
# 该文件被 deployments/compose.yaml 通过 --env-file 读取，不会打进镜像。

# ---------- 必填 ----------
# 生成方式：openssl rand -hex 24   /   PowerShell: [guid]::NewGuid().ToString('N')
RESEARCHOS_API_TOKEN=
POSTGRES_PASSWORD=

# ---------- 数据库 ----------
POSTGRES_USER=researchos
POSTGRES_DB=researchos
# 只绑 127.0.0.1，改这里等于把数据库暴露出去，除非你清楚在做什么
POSTGRES_PORT=55432

# ---------- 服务 ----------
APP_BIND=127.0.0.1
APP_PORT=8080
APP_MEMORY_LIMIT=2g
RESEARCHOS_VERSION=1.0.0
TZ=Asia/Shanghai

# ---------- 主密钥（可选） ----------
# 留空：首次启动在 /data/secret.key 生成 32 字节随机密钥（0600），随 appdata 卷持久化。
# 填写：openssl rand -base64 32 的结果，用于多副本或迁移场景。
# 换掉这个值 = 库里所有已加密的 API Key 都解不开，需要重新在界面里填一遍。
RESEARCHOS_SECRET_KEY=

# ---------- 执行参数 ----------
RESEARCHOS_WORKERS=4
RESEARCHOS_MAX_AGENTS=4
RESEARCHOS_NODE_TIMEOUT=180s
RESEARCHOS_REQUIRE_APPROVAL=true
RESEARCHOS_RESPECT_ROBOTS=true

# ---------- 检索 ----------
RESEARCHOS_SEARCH_PROVIDERS=github,hackernews,wikipedia
RESEARCHOS_GITHUB_TOKEN=
RESEARCHOS_TAVILY_API_KEY=
RESEARCHOS_SERPAPI_KEY=
RESEARCHOS_BRAVE_API_KEY=

# ---------- 大模型（留空则走启发式规划） ----------
RESEARCHOS_LLM_PROVIDER=none
RESEARCHOS_LLM_API_KEY=
RESEARCHOS_LLM_MODEL=
RESEARCHOS_LLM_BASE_URL=
